{
	"name": "@betfinio/template-contract",
	"description": "Template for Betfin smart contracts",
	"version": "1.0.0",
	"author": {
		"name": "betfinio",
		"url": "https://github.com/betfinio"
	},
	"dependencies": {
		"@openzeppelin/contracts": "^5.3.0"
	},
	"devDependencies": {
		"forge-std": "github:foundry-rs/forge-std#v1.8.1",
		"solhint": "^5.0.5"
	},
	"keywords": [
		"blockchain",
		"ethereum",
		"forge",
		"foundry",
		"smart-contracts",
		"solidity",
		"template"
	],
	"private": true,
	"scripts": {
		"clean": "rm -rf cache out",
		"build": "forge build",
		"lint": "bun run lint:sol",
		"lint:sol": "forge fmt --check && bun solhint \"{script,src,test}/**/*.sol\"",
		"test": "forge test",
		"test:coverage": "forge coverage",
		"test:coverage:report": "forge coverage --report lcov",
		"deploy:dev": "bash script/sh/deploy.sh dev",
		"deploy:dev:broadcast": "bash script/sh/deploy.sh dev broadcast",
		"deploy:prod": "bash script/sh/deploy.sh prod",
		"deploy:prod:broadcast": "bash script/sh/deploy.sh prod broadcast"
	}
}
